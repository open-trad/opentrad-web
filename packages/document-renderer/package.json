{
  "name": "@opentrad/document-renderer",
  "version": "1.0.0",
  "private": true,
  "description": "Shared deterministic document renderers for OpenTrad",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check src tests",
    "pretest": "pnpm --filter @opentrad/document-core build && pnpm build",
    "test": "vitest run && node scripts/committed-baseline-smoke.mjs",
    "test:native-import": "pnpm build && node scripts/native-import-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@opentrad/document-core": "workspace:*",
    "docx": "9.7.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  }
}
